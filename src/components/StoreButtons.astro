---
import { APP_STORE_URL, PLAY_STORE_URL } from '../consts';

interface Props {
	/** `light` renders for dark backgrounds, `dark` for light backgrounds. */
	variant?: 'light' | 'dark';
	align?: 'start' | 'center';
	class?: string;
}

const { variant = 'light', align = 'center', class: className = '' } = Astro.props;

const badge =
	variant === 'light'
		? 'border-white/25 bg-white/10 text-white backdrop-blur hover:bg-white/20'
		: 'border-navy-800/10 bg-navy-900 text-white hover:bg-navy-800';

const caption = variant === 'light' ? 'text-white/70' : 'text-white/65';
---

<div
	class:list={[
		'flex flex-col gap-3 sm:flex-row',
		align === 'center' ? 'items-center justify-center' : 'items-stretch sm:items-center',
		className,
	]}
>
	<a
		href={APP_STORE_URL}
		class:list={[
			'flex w-full items-center justify-center gap-3 rounded-2xl border px-5 py-3 transition duration-200 hover:-translate-y-0.5 sm:w-auto sm:min-w-[11rem]',
			badge,
		]}
	>
		<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
			><path
				d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"
			></path></svg
		>
		<span class="text-left leading-tight">
			<span class:list={['block text-[11px]', caption]}>Download on the</span>
			<span class="block text-base font-semibold">App Store</span>
		</span>
	</a>

	<a
		href={PLAY_STORE_URL}
		class:list={[
			'flex w-full items-center justify-center gap-3 rounded-2xl border px-5 py-3 transition duration-200 hover:-translate-y-0.5 sm:w-auto sm:min-w-[11rem]',
			badge,
		]}
	>
		<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
			><path
				d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.3 2.3-8.636-8.632z"
			></path></svg
		>
		<span class="text-left leading-tight">
			<span class:list={['block text-[11px]', caption]}>Get it on</span>
			<span class="block text-base font-semibold">Google Play</span>
		</span>
	</a>
</div>
