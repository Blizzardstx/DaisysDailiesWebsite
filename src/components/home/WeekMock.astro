---
/**
 * Illustration of the Family Week view: the next 7 days grouped by person,
 * with an Unassigned lane and the "I'll take it" claim button.
 */
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

const lanes = [
	{
		name: 'Alex',
		color: 'var(--color-petal-rose)',
		stops: [
			{ day: 'Mon', title: 'School run' },
			{ day: 'Wed', title: 'Pharmacy' },
			{ day: 'Fri', title: 'Vet' },
			{ day: 'Sat', title: 'Grocery run' },
		],
	},
	{
		name: 'Jordan',
		color: 'var(--color-petal-teal)',
		stops: [
			{ day: 'Tue', title: 'Soccer practice' },
			{ day: 'Sat', title: 'Hardware store' },
		],
	},
];

const busiest = Math.max(...lanes.map((lane) => lane.stops.length));
---

<div
	role="img"
	aria-label="Illustration of the Family Week view: Alex has 4 stops this week, Jordan has 2, and an unassigned dry cleaning stop on Thursday has an “I’ll take it” button."
	class="rounded-3xl border border-navy-100 bg-navy-50/70 p-4 sm:p-5"
>
	<div aria-hidden="true">
		<div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between">
			<p class="whitespace-nowrap text-[11px] font-bold uppercase tracking-widest text-navy-500">
				Next 7 days
			</p>
			<ol class="flex justify-between sm:justify-start sm:gap-1">
				{
					days.map((day, index) => (
						<li
							class:list={[
								'flex h-7 w-7 items-center justify-center rounded-full text-[11px] font-bold',
								index === 0 ? 'bg-navy-900 text-white' : 'bg-white text-navy-500',
							]}
						>
							{day[0]}
						</li>
					))
				}
			</ol>
		</div>

		<div class="mt-4 space-y-2.5">
			{
				lanes.map((lane) => (
					<div class="rounded-2xl border border-navy-100 bg-white p-3.5 shadow-sm">
						<div class="flex items-center gap-2.5">
							<span
								class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[12px] font-extrabold text-white"
								style={`background-color: ${lane.color}`}
							>
								{lane.name[0]}
							</span>
							<p class="text-[15px] font-bold text-navy-900">{lane.name}</p>
							<span class="ml-auto text-[12px] font-semibold text-navy-500">
								{lane.stops.length} stops
							</span>
							<span class="h-1.5 w-14 overflow-hidden rounded-full bg-navy-100">
								<span
									class="block h-full rounded-full"
									style={`width: ${(lane.stops.length / busiest) * 100}%; background-color: ${lane.color}`}
								/>
							</span>
						</div>

						<ul class="mt-3 flex flex-wrap gap-2">
							{lane.stops.map((stop) => (
								<li class="flex items-center gap-1.5 rounded-full bg-navy-50 py-1 pl-1 pr-3 text-[13px] font-semibold text-navy-800">
									<span class="rounded-full bg-white px-2 py-0.5 text-[11px] font-bold text-navy-500">
										{stop.day}
									</span>
									{stop.title}
								</li>
							))}
						</ul>
					</div>
				))
			}

			<div class="rounded-2xl border border-dashed border-navy-300 bg-white/60 p-3.5">
				<p class="text-[11px] font-bold uppercase tracking-widest text-navy-500">Unassigned</p>
				<div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
					<p class="flex items-center gap-1.5 text-[13px] font-semibold text-navy-800">
						<span class="rounded-full bg-navy-100 px-2 py-0.5 text-[11px] font-bold text-navy-500">
							Thu
						</span>
						Dry cleaning
					</p>
					<span class="rounded-full bg-brand-500 px-3.5 py-1.5 text-[12px] font-semibold text-white">
						I’ll take it
					</span>
				</div>
			</div>
		</div>
	</div>
</div>
