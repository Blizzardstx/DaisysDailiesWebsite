---
/**
 * The product metaphor, drawn: one flower is a day, one petal is a stop.
 * Petals bloom outward on load and the whole head turns very slowly, the way
 * the app's flower clock does.
 */
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const CENTER = 200;
/** Petals span radius 61–153 from the centre; badges sit just inside each tip. */
const TIP_RADIUS = 140;

const petals = [
	{ color: '#F4F6FF', label: 'Open' },
	{ color: '#F7CE46', label: 'Groceries', done: true },
	{ color: '#B8CE4F', label: 'Open' },
	{ color: '#3FC5BE', label: 'Pharmacy', done: true },
	{ color: '#6FC3EA', label: 'Open' },
	{ color: '#4E86D8', label: 'Open' },
	{ color: '#7C5BD9', label: 'School pickup', done: true },
	{ color: '#B98BD6', label: 'Open' },
	{ color: '#F2685B', label: 'Open' },
	{ color: '#F5709A', label: 'Dry cleaning', done: true },
	{ color: '#F59A4B', label: 'Open' },
	{ color: '#F5B942', label: 'Open' },
];

const step = 360 / petals.length;

const decorated = petals.map((petal, index) => {
	const angle = index * step;
	const radians = (angle * Math.PI) / 180;

	return {
		...petal,
		index,
		angle,
		tipX: CENTER + TIP_RADIUS * Math.sin(radians),
		tipY: CENTER - TIP_RADIUS * Math.cos(radians),
	};
});

const doneCount = petals.filter((petal) => petal.done).length;
---

<svg
	viewBox="0 0 400 400"
	role="img"
	aria-label={`Illustration of a day planned as a flower: ${doneCount} of ${petals.length} stops complete`}
	class:list={['flower', className]}
>
	<defs>
		<radialGradient id="flower-center" cx="38%" cy="32%" r="72%">
			<stop offset="0%" stop-color="#FFE9A3"></stop>
			<stop offset="55%" stop-color="#F7C948"></stop>
			<stop offset="100%" stop-color="#E09A12"></stop>
		</radialGradient>
		<radialGradient id="flower-glow" cx="50%" cy="50%" r="50%">
			<stop offset="0%" stop-color="#8FA5FF" stop-opacity="0.35"></stop>
			<stop offset="100%" stop-color="#8FA5FF" stop-opacity="0"></stop>
		</radialGradient>
	</defs>

	<circle cx="200" cy="200" r="185" fill="url(#flower-glow)"></circle>

	<g class="flower-head">
		{
			decorated.map((petal) => (
				<g class="petal" style={`--rot:${petal.angle}deg; --i:${petal.index}`}>
					{/* Opaque base so unfinished petals read as pastel, not muddy. */}
					<ellipse cx="200" cy="93" rx="21" ry="46" fill="#EEF1FA" />
					<ellipse
						cx="200"
						cy="93"
						rx="21"
						ry="46"
						fill={petal.color}
						opacity={petal.done ? 1 : 0.45}
					/>
					<ellipse cx="193" cy="80" rx="6.5" ry="19" fill="#ffffff" opacity="0.32" />
				</g>
			))
		}

		{
			decorated
				.filter((petal) => petal.done)
				.map((petal) => (
					<g class="petal-check" style={`--i:${petal.index}`}>
						<circle cx={petal.tipX} cy={petal.tipY} r="13" fill="#16203A" opacity="0.92" />
						<path
							d={`M${petal.tipX - 5.5} ${petal.tipY} l4 4 l7 -8`}
							fill="none"
							stroke="#ffffff"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</g>
				))
		}
	</g>

	<circle cx="200" cy="200" r="46" fill="url(#flower-center)"></circle>
	<circle
		cx="200"
		cy="200"
		r="52"
		fill="none"
		stroke="#F7C948"
		stroke-width="5"
		stroke-linecap="round"
		stroke-dasharray="2.5 8"
		opacity="0.9"></circle>
	<circle cx="200" cy="200" r="33" fill="#ffffff" opacity="0.16"></circle>

	{/* Clock hands, echoing the app icon. */}
	<g stroke="#16203A" stroke-linecap="round">
		<line x1="200" y1="200" x2="200" y2="168" stroke-width="6"></line>
		<line x1="200" y1="200" x2="228" y2="211" stroke-width="5"></line>
	</g>
	<circle cx="200" cy="200" r="5" fill="#FFF6DC" stroke="#E09A12" stroke-width="1.5"></circle>
</svg>

<style>
	.flower {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		overflow: visible;
	}

	.flower-head {
		transform-box: view-box;
		transform-origin: 200px 200px;
		animation: flower-turn 120s linear infinite;
	}

	.petal-check {
		transform-box: fill-box;
		transform-origin: center;
	}

	.petal {
		transform-box: view-box;
		transform-origin: 200px 200px;
		transform: rotate(var(--rot));
		animation: petal-bloom 900ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
		animation-delay: calc(var(--i) * 65ms);
	}

	.petal-check {
		animation: check-pop 500ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
		animation-delay: calc(900ms + var(--i) * 65ms);
	}

	@keyframes petal-bloom {
		from {
			opacity: 0;
			transform: rotate(var(--rot)) scale(0.12);
		}
		to {
			opacity: 1;
			transform: rotate(var(--rot)) scale(1);
		}
	}

	@keyframes check-pop {
		from {
			opacity: 0;
			transform: scale(0.4);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes flower-turn {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flower-head,
		.petal,
		.petal-check {
			animation: none;
		}
	}
</style>
