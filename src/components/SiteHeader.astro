---
import { NAV_LINKS, SITE } from '../consts';

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
	!href.includes('#') && pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<header class="sticky top-0 z-50">
	{/* Petal spectrum hairline — the daisy, abstracted. */}
	<div
		class="h-1 w-full bg-[linear-gradient(90deg,var(--color-petal-rose),var(--color-petal-coral),var(--color-petal-amber),var(--color-petal-sun),var(--color-petal-lime),var(--color-petal-teal),var(--color-petal-sky),var(--color-petal-blue),var(--color-petal-violet),var(--color-petal-lilac))]"
	>
	</div>

	<div
		class="border-b border-navy-100/80 bg-white/95 backdrop-blur-lg supports-[backdrop-filter]:bg-white/80"
	>
		<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-6">
			<a href="/" class="group flex shrink-0 items-center gap-2.5">
				<img
					src="/icon.png"
					alt=""
					width="36"
					height="36"
					class="h-9 w-9 rounded-[11px] shadow-sm transition group-hover:scale-105"
				/>
				<span class="text-[15px] font-extrabold tracking-tight text-navy-900">
					{SITE.name}
				</span>
			</a>

			<nav aria-label="Main" class="hidden items-center gap-1 md:flex">
				{
					NAV_LINKS.map((link) => (
						<a
							href={link.href}
							aria-current={isCurrent(link.href) ? 'page' : undefined}
							class="rounded-full px-3.5 py-2 text-sm font-medium text-navy-600 transition hover:bg-navy-50 hover:text-navy-900 aria-[current=page]:text-brand-500"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex items-center gap-2">
				<a href="/download" class="btn btn-primary hidden sm:inline-flex">Get the app</a>

				<button
					type="button"
					id="nav-toggle"
					aria-expanded="false"
					aria-controls="mobile-nav"
					class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-navy-200 text-navy-700 transition hover:bg-navy-50 md:hidden"
				>
					<span class="sr-only">Toggle navigation</span>
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path
							d="M3 6h14M3 10h14M3 14h14"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
		</div>

		<nav
			id="mobile-nav"
			aria-label="Mobile"
			hidden
			class="border-t border-navy-100 bg-white px-5 pb-5 pt-2 md:hidden"
		>
			<ul class="flex flex-col">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								class="block rounded-xl px-3 py-3 text-[15px] font-medium text-navy-700 transition hover:bg-navy-50"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a href="/download" class="btn btn-primary mt-3 w-full">Get the app</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('mobile-nav');

	if (toggle && panel) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		// Close after tapping a link (same-page anchors don't reload).
		panel.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
	}
</script>
