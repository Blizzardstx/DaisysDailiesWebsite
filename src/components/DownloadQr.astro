---
/**
 * QR code for https://daisysdailies.com/download, the smart redirect page that
 * sends a phone to the right store. For visitors on a computer, who cannot
 * install from where they are. Shown from the `lg` breakpoint up, and written
 * for dark backgrounds.
 *
 * The code is a fixed drawing of that one URL (29×29 modules, error
 * correction M). If the URL ever changes, regenerate QR_PATH with the
 * `qrcode` npm package rather than editing it by hand.
 */
interface Props {
	align?: 'start' | 'center';
	class?: string;
}

const { align = 'start', class: className = '' } = Astro.props;

const QR_SIZE = 29;
/** Quiet zone around the code, in modules. Scanners need this margin. */
const QUIET = 3;
const QR_PATH =
