---

<div
	class:list={[
		'hidden items-center gap-4 lg:flex',
		align === 'center' ? 'justify-center' : 'justify-start',
		className,
	]}
>
	<svg
		viewBox={`${-QUIET} ${-QUIET} ${QR_SIZE + QUIET * 2} ${QR_SIZE + QUIET * 2}`}
		width="96"
		height="96"
		role="img"
		aria-label="QR code that opens the Daisy's Dailies download page"
		class="h-24 w-24 shrink-0 rounded-2xl bg-white shadow-lift"
		shape-rendering="crispEdges"
	>
		<path d={QR_PATH} fill="#16203A"></path>
	</svg>
	<p class="max-w-[13rem] text-left text-sm leading-relaxed text-white/70">
		<span class="block font-semibold text-white">On a computer?</span>
		Point your phone’s camera here to get the app.
	</p>
</div>
