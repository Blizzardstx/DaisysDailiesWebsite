---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StoreButtons from '../components/StoreButtons.astro';
import FlowerGraphic from '../components/FlowerGraphic.astro';
import IconBadge from '../components/home/IconBadge.astro';
import QuickAddMock from '../components/home/QuickAddMock.astro';
import RepeatsMock from '../components/home/RepeatsMock.astro';
import WeekMock from '../components/home/WeekMock.astro';
import PlanWeekMock from '../components/home/PlanWeekMock.astro';
import DownloadQr from '../components/DownloadQr.astro';
import { icons, type IconName } from '../components/home/icons';
import { APP_STORE_ID, SITE } from '../consts';

/**
 * Tier numbers, as built for app version 2.0.0. The pricing cards and the FAQ
 * answers below are all generated from this object — change a number here and
 * every mention on the page follows.
 *
 * "Unlimited" is only true for Pro route stops and Pro repeats. The free AI
 * allowance is a one-time 10, not a monthly one.
 */
const TIERS = {
	trialDays: 14,
	free: { flowers: 5, petals: 12, members: 2, repeats: 3, routeStops: 5, uncappedRoutes: 3, aiRequests: 10 },
	pro: { flowers: 50, petals: 24, members: 10, aiRequestsPerMonth: 300 },
	/** US dollars. The stores set the local price in other countries. */
	price: { monthly: 4.99, yearly: 29.99, lifetime: 74.99 },
} as const;

const { trialDays, free, pro, price } = TIERS;

/** What the yearly plan works out to per month, e.g. "2.50". */
const yearlyPerMonth = (price.yearly / 12).toFixed(2);

/** The 12 app languages, from SUPPORTED_LOCALES in the app's src/i18n. */
const languages = [
	'English',
	'Chinese (Simplified)',
	'Dutch',
	'French',
	'German',
	'Italian',
	'Japanese',
	'Korean',
	'Polish',
	'Portuguese',
	'Spanish',
	'Turkish',
];
const languageList = `${languages.slice(0, -1).join(', ')}, and ${languages.at(-1)}`;

const description =
	"Turn your errands into a flower. Daisy's Dailies is the visual way for families to plan the day and the week — errands, appointments, routes, and who's doing what.";

const steps = [
	{
		number: '01',
		title: 'Plant a flower',
		body: 'A flower is one day, one trip, one project, or one category of to-dos. Name it and it is ready to fill.',
		color: 'var(--color-petal-sun)',
	},
	{
		number: '02',
		title: 'Add your petals',
		body: 'Type them, say them, or let them repeat. The pharmacy, the school run, the Saturday hardware store trip.',
		color: 'var(--color-petal-teal)',
	},
	{
		number: '03',
		title: 'Head out in order',
		body: 'Optimize the route, see travel times between stops, and check petals off as you go.',
		color: 'var(--color-petal-violet)',
	},
];

const essentials: { title: string; body: string; color: string; icon: IconName }[] = [
	{
		title: 'Visual planning',
		body: 'Every errand becomes a petal on your flower. See your whole day at a glance, not a wall of checkboxes.',
		color: 'var(--color-petal-sun)',
		icon: 'flower',
	},
	{
		title: 'Route planning',
		body: 'Optimize the order of your stops and see real travel times between them before you leave the house. Tell the AI what matters, like “pharmacy before 5.”',
		color: 'var(--color-petal-teal)',
		icon: 'route',
	},
	{
		title: 'Appointments included',
		body: 'Track appointments on every plan, no gate, no upsell. Add Pro and the calendars you choose flow in on their own — new events on your phone show up without you lifting a finger.',
		color: 'var(--color-petal-sky)',
		icon: 'calendar',
	},
	{
		title: 'Family notifications',
		body: 'A nudge when a stop is assigned or done, an evening heads-up for tomorrow, and a Sunday recap of who did what. So no one has to ask “did you get that?”',
		color: 'var(--color-petal-amber)',
		icon: 'bell',
	},
];

/** Smaller features that shipped before 2.0 and were never on the site. */
const extras: { title: string; body: string; color: string; icon: IconName }[] = [
	{
		title: 'Favorite petals',
		body: 'Keep the stops you use most a tap away.',
		color: 'var(--color-petal-sun)',
		icon: 'star',
	},
	{
		title: 'Saved places',
		body: 'Your own address book — name, address, and notes for the places you go.',
		color: 'var(--color-petal-coral)',
		icon: 'pin',
	},
	{
		title: 'Search',
		body: 'Find that one stop or list item without scrolling for it.',
		color: 'var(--color-petal-teal)',
		icon: 'search',
	},
	{
		title: 'Home-screen shortcuts',
		body: 'Put a petal on your phone’s home screen and open it in one tap.',
		color: 'var(--color-petal-blue)',
		icon: 'shortcut',
	},
	{
		title: 'Shareable flower links',
		body: 'Send a flower to someone with a link.',
		color: 'var(--color-petal-rose)',
		icon: 'link',
	},
	{
		title: 'Petal styles',
		body: 'Pick the look that suits your flowers.',
		color: 'var(--color-petal-lilac)',
		icon: 'brush',
	},
	{
		title: 'Dark mode',
		body: 'Easier on the eyes when you plan tomorrow tonight.',
		color: 'var(--color-petal-violet)',
		icon: 'moon',
	},
	{
		title: `${languages.length} languages`,
		body: 'The app — and every notification — in the language you choose.',
		color: 'var(--color-petal-lime)',
		icon: 'globe',
	},
];

const freePlan = [
	`${free.flowers} flowers, ${free.petals} petals per flower`,
	`${free.members} family members`,
	`${free.repeats} repeating petals & appointments at a time`,
	`Route planning for up to ${free.routeStops} stops (your first ${free.uncappedRoutes} routes have no cap)`,
	`${free.aiRequests} AI requests to try Quick Add & AI route optimization`,
	'Family Week: today’s view',
	'Appointments & notifications',
];

const proPlan = [
	`${pro.flowers} flowers, ${pro.petals} petals per flower`,
	`${pro.members} family members`,
	'Unlimited repeating petals & appointments',
	'Unlimited route stops',
	`${pro.aiRequestsPerMonth} AI requests a month for Quick Add, Plan My Week & route optimization`,
	'Family Week: the full week, plus who has what',
	'Plan My Week',
	'Calendar import & sync, real-time travel times',
];

/** Wording here follows the Privacy Policy; keep the two in step. */
const privacyPoints: { title: string; body: string; icon: IconName }[] = [
	{
		title: 'Your voice stays on your phone',
		body: 'Speech recognition runs entirely on your device. Your voice is never recorded, stored, or sent to us or to any third party.',
		icon: 'mic',
	},
	{
		title: 'Names are swapped out',
		body: 'AI features run only when you start them. Family members’ first names are replaced with placeholders before anything is sent.',
		icon: 'swap',
	},
	{
		title: 'Your data is yours',
		body: 'Export your data or delete your account whenever you like, right from Settings.',
		icon: 'export',
	},
];

/** An inline link inside an FAQ answer. Answers are rendered as HTML. */
const faqLink = (href: string, label: string) =>
	`<a href="${href}" class="font-semibold text-brand-500 underline-offset-4 hover:underline">${label}</a>`;

/**
 * FAQ, grouped by topic. Tier numbers and prices come from TIERS, so they stay in
 * step with the pricing cards. Answers are HTML strings (for the links), so keep
 * them to plain text plus faqLink().
 */
const faqGroups: { id: string; title: string; items: { q: string; a: string }[] }[] = [
	{
		id: 'faq-getting-started',
		title: 'Getting started',
		items: [
			{
				q: 'What exactly is a “flower”?',
				a: 'A flower is a container for one day, trip, or project. Each petal around it is a single stop or task, and each petal holds its own checklist of items. It’s the same information a to-do app would show you, just arranged so you can read the whole thing in one glance.',
			},
			{
				q: 'How do I sign up?',
				a: 'Sign in with Apple, Google, or an email address. You need to be 13 or older (16 or older in the EU). If you use email, you’ll confirm your address before you create or join a family.',
			},
			{
				q: 'Do I need an internet connection?',
				a: 'Yes. Daisy’s Dailies keeps your whole family in sync in real time, so it needs a connection to save changes. If you lose signal, a banner tells you, and your changes save again once you’re back online.',
			},
			{
				q: 'Which devices are supported?',
				a: 'Daisy’s Dailies runs on iPhone, iPad, and Android phones and tablets. Your data syncs across every device you sign in on.',
			},
			{
				q: 'Is it available in my language?',
				a: `Daisy’s Dailies comes in ${languages.length} languages: ${languageList}. Every notification arrives in the language you use the app in.`,
			},
			{
				q: 'Is there a dark mode?',
				a: 'Yes. Choose light, dark, or match your phone’s setting in Settings.',
			},
		],
	},
	{
		id: 'faq-planning',
		title: 'Planning your day',
		items: [
			{
				q: 'What is Plan Your Day?',
				a: 'It’s one list of everything happening today: the stops you’ve added to your day, petals scheduled for today, and today’s appointments. Pick a departure time and the app estimates when you’ll reach each stop.',
			},
			{
				q: 'Can I get directions to my stops?',
				a: 'Yes. Choose the stops, put them in order, and the app hands the route to Google Maps, Apple Maps, or Waze. Before you leave, a checklist reminds you what to bring, return, pick up, or drop off.',
			},
			{
				q: 'Can the app put my stops in the best order?',
				a: `Yes. AI route optimization suggests an order based on your stops, their times, and any note you add, such as “pharmacy before it closes at 6.” On Free, you get ${free.aiRequests} AI requests to try it, shared with Quick Add. Pro includes ${pro.aiRequestsPerMonth} a month.`,
			},
			{
				q: 'How are travel times estimated?',
				a: 'On Free, travel times are estimated from distance and time of day. Pro uses real-time traffic.',
			},
			{
				q: 'Can I make an errand repeat?',
				a: `Yes. Petals and appointments can repeat daily, weekly (on the days you choose), or monthly, with an optional end date. A repeating petal moves to its next date when you complete or skip it. If you miss it, it stays overdue until you deal with it, and you can have its checklist uncheck itself each time. Appointments move forward on their own once their day ends. Free families can have ${free.repeats} repeats going at once; Pro has no limit.`,
			},
			{
				q: 'Are appointments included on the free plan?',
				a: 'Yes. Every plan includes appointments. You can create them by hand or start one from a place saved in your Address Book. Appointments are removed automatically 30 days after their date.',
			},
			{
				q: 'Can I import events from my calendar?',
				a: 'Yes, with Pro. Daisy’s Dailies reads the events you choose from your phone’s calendar and can keep them in sync. It never writes to or changes your calendar.',
			},
			{
				q: 'What is the Address Book?',
				a: 'It’s a list of places you visit often, like your doctor, the school, or the salon. Saving a place once lets you fill in its address and usual duration with a tap when you add an appointment.',
			},
			{
				q: 'Can I add things by voice or in plain words?',
				a: 'Yes. Quick Add lets you type or say something like “pick up dry cleaning Thursday and get milk,” and AI turns it into petals and items. You review everything before it’s saved, and you can undo it afterward.',
			},
			{
				q: 'Does voice input work on every phone?',
				a: 'The microphone appears on phones that can recognize speech on the device in the language you use the app in. On iPhone, the app’s language also needs to match the phone’s language. If you don’t see it, you can type instead. Quick Add works the same either way.',
			},
			{
				q: 'I deleted something by mistake. Can I get it back?',
				a: 'Usually, yes. After you delete an item, a petal, or an Address Book entry, an Undo button appears for a few seconds. Deleting a whole flower or your account asks you to confirm first and can’t be undone.',
			},
			{
				q: 'Can I put a stop on my home screen?',
				a: 'On Android, long-press a petal and choose Add to Home Screen to get its own icon. On iPhone, the same option gives you a link that opens the petal directly.',
			},
		],
	},
	{
		id: 'faq-family',
		title: 'Family sharing',
		items: [
			{
				q: 'How does family sharing work?',
				a: `One person creates the family and invites the others. Everyone sees the same flowers, petals, and items, so a stop crossed off by one person is crossed off for everyone. The Family tab opens on a week view that shows who has what, and anyone who can edit can tap “I’ll take it” on a stop nobody has claimed. Free families hold ${free.members} people. Pro families hold up to ${pro.members}.`,
			},
			{
				q: 'How do I invite someone?',
				a: 'Open the Family tab and create an invite code. It works for 24 hours. The other person enters it after signing up.',
			},
			{
				q: 'Can I control what family members can change?',
				a: 'Yes. The family owner gives each member Write access (can add and edit) or Read access (can view only).',
			},
			{
				q: 'Does everyone in the family need to buy Pro?',
				a: 'No. One Pro purchase upgrades the whole family, whether it’s monthly, yearly, or lifetime. If the person who paid leaves the family or deletes their account, the family goes back to Free.',
			},
			{
				q: 'Will I be notified when something is assigned to me?',
				a: 'Yes. Notifications can tell you when a stop is assigned to you, when a stop you assigned is done, and when an appointment is coming up. You can also get a morning summary at a time you pick, an evening “plan tomorrow” reminder, and a Sunday recap of the week. Each one can be turned on or off in Settings.',
			},
			{
				q: 'What is Plan My Week?',
				a: 'It’s a Pro feature in the Family tab. AI looks at your flexible errands, your fixed appointments, and the hours you’ve said you’re free, then suggests a day for each errand. Nothing changes until you apply the suggestions, and one Undo reverses them all.',
			},
		],
	},
	{
		id: 'faq-pricing',
		title: 'Plans and pricing',
		items: [
			{
				q: 'Do I need to pay to use it?',
				a: `No. The free tier covers ${free.flowers} flowers, ${free.petals} petals each, ${free.members} family members, ${free.repeats} repeats going at once, and route planning for up to ${free.routeStops} stops. Your first ${free.uncappedRoutes} routes have no stop limit, and you get ${free.aiRequests} AI requests to try Quick Add and route optimization. Appointments and notifications are included on every tier, and every new family starts with ${trialDays} days of Pro, no card needed. Pro raises the limits and adds the full Family Week, Plan My Week, calendar import and sync, real-time travel times, and ${pro.aiRequestsPerMonth} AI requests a month.`,
			},
			{
				q: `What happens after the ${trialDays}-day Pro trial?`,
				a: `Your family moves to Free. Nothing you made is deleted, and there’s nothing to cancel because we never asked for a card. If you have more than ${free.repeats} repeats going, the extras pause, and members past the first ${free.members} become read-only, until you upgrade or trim the list. Already using the free app? You get the same ${trialDays} days once, the first time you open version 2.0.`,
			},
			{
				q: 'What Pro plans are there?',
				a: `Monthly ($${price.monthly}), yearly ($${price.yearly}, about $${yearlyPerMonth} a month), or lifetime access for a one-time $${price.lifetime} that never renews. Each one covers your whole family, and every new family can try Pro free for ${trialDays} days first. Prices are in US dollars; the App Store and Google Play show your local price in other countries.`,
			},
			{
				q: 'I got a new phone. How do I get Pro back?',
				a: 'Sign in to the same account. Pro belongs to your family, so it comes back with you. If it doesn’t, use Restore Purchases in Settings.',
			},
		],
	},
	{
		id: 'faq-privacy',
		title: 'Privacy and your account',
		items: [
			{
				q: 'What does the AI see?',
				a: `Only what it needs, and only when you start it. Quick Add sends the text you type or say, never your voice. Plan My Week sends the names, times, and durations of the stops being planned, with locations rounded to about 1 km. Family members’ first names are replaced with placeholders before anything is sent, and no account identifiers go with it. The AI features run on Google Gemini, and our ${faqLink('/privacy-policy', 'Privacy Policy')} lists exactly what each one sends.`,
			},
			{
				q: 'Is my family’s data sold or used for ads?',
				a: 'No. There are no ads in the app and we don’t sell your data. Pro purchases are the only thing funding development, which is exactly why we can keep it that way.',
			},
			{
				q: 'How do I cancel or delete my account?',
				a: `Subscriptions are billed by the App Store or Google Play, so you cancel them in your device settings. Lifetime is a one-time purchase, so there’s nothing to cancel. To remove your data, use Settings → Delete Account in the app, or follow the step-by-step instructions on our ${faqLink('/data-deletion', 'data deletion page')}. If you own the family, deleting your account deletes the family and everything in it for everyone.`,
			},
			{
				q: 'How do I contact you?',
				a: `Email us at ${faqLink(`mailto:${SITE.email}`, SITE.email)} or use Contact Us in Settings. We reply within 24–48 hours.`,
			},
		],
	},
];
---

<Layout
	title="Daisy's Dailies — Visual Family Planner for Your Day and Week"
	description={description}
>
	{/* Safari on iPhone and iPad shows an "open in the App Store" bar for this. */}
	<meta slot="head" name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

	<SiteHeader />

	<main id="main">
		<!-- Hero -->
		<section class="relative overflow-hidden bg-navy-800 text-white">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_15%_0%,#3f4d7a_0%,transparent_55%),radial-gradient(90%_70%_at_100%_10%,#4a5fdd33_0%,transparent_60%)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative mx-auto grid max-w-6xl items-center gap-20 px-5 py-16 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:py-24"
			>
				<div class="animate-bloom min-w-0 text-center lg:text-left">
					<a
						href="#features"
						class="eyebrow inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-white/80 transition hover:bg-white/15"
					>
						<span class="inline-block h-1.5 w-1.5 rounded-full bg-petal-sun" aria-hidden="true"
						></span>
						New in 2.0 · Plan the whole week
					</a>

					<h1 class="mt-6 text-4xl font-extrabold leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
						Your family's day,{' '}
						<span
							class="block bg-[linear-gradient(100deg,var(--color-petal-sun),var(--color-petal-rose),var(--color-petal-sky))] bg-clip-text pb-1 text-transparent"
						>
							in full bloom
						</span>
					</h1>

					<p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-white/75 lg:mx-0">
						Errands, appointments, and to-dos laid out as petals around a single flower — plus a
						week view that shows who's doing what.
					</p>

					<div id="download" class="mt-9 scroll-mt-28">
						<StoreButtons align="start" class="sm:justify-center lg:justify-start" />
					</div>

					<ul
						class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-white/60 lg:justify-start"
					>
						<li class="flex items-center gap-2">
							<span class="h-1.5 w-1.5 rounded-full bg-petal-teal" aria-hidden="true"></span>
							{trialDays} days of Pro, no card
						</li>
						<li class="flex items-center gap-2">
							<span class="h-1.5 w-1.5 rounded-full bg-petal-rose" aria-hidden="true"></span>
							No ads
						</li>
						<li class="flex items-center gap-2">
							<span class="h-1.5 w-1.5 rounded-full bg-petal-lilac" aria-hidden="true"></span>
							Up to {pro.members} family members
						</li>
					</ul>

					<DownloadQr class="mt-9" />
				</div>

				<div class="relative mx-auto w-full min-w-0 max-w-md lg:max-w-none">
					<div
						class="animate-drift rounded-5xl border border-white/10 bg-white/[0.07] p-5 pt-24 shadow-lift-lg backdrop-blur-sm sm:p-7 sm:pt-16 lg:pt-7"
					>
						<FlowerGraphic />
						<p class="mt-2 text-sm font-semibold text-white">
							Saturday <span class="font-normal text-white/55">· 4 of 12 stops done</span>
						</p>
					</div>

					{/* Quick Add: one sentence in, one repeating petal out. */}
					<div
						class="absolute -left-2 -top-12 w-[14.5rem] rounded-2xl border border-white/15 bg-navy-900/90 p-3.5 shadow-lift backdrop-blur sm:-left-6"
					>
						<p
							class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-widest text-white/50"
						>
							<svg
								width="12"
								height="12"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.wand}
							/>
							Quick Add
						</p>
						<p class="mt-1.5 text-sm font-semibold leading-snug text-white">
							“Soccer practice every Tuesday at 5”
						</p>
						<div class="mt-2.5 flex items-center gap-2 rounded-xl bg-white/10 px-2.5 py-2">
							<span class="h-2.5 w-2.5 shrink-0 rounded-full bg-petal-lime" aria-hidden="true"
							></span>
							<p class="text-xs font-semibold leading-snug text-white">
								Soccer practice
								<span class="block font-normal text-white/55">Tue 5:00pm · repeats weekly</span>
							</p>
						</div>
					</div>

					<div class="absolute -right-1 bottom-14 flex flex-col gap-2.5 sm:-right-4 sm:bottom-16">
						<div
							class="flex items-center gap-2.5 rounded-2xl border border-white/15 bg-navy-900/85 px-3.5 py-2.5 shadow-lift backdrop-blur"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-petal-teal" aria-hidden="true"></span>
							<p class="text-sm font-semibold text-white">
								Pharmacy <span class="font-normal text-white/50">· 2:30pm</span>
							</p>
						</div>

						<div
							class="flex items-center gap-2.5 rounded-2xl border border-white/15 bg-navy-900/85 px-3.5 py-2.5 shadow-lift backdrop-blur"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-petal-rose" aria-hidden="true"></span>
							<p class="text-sm font-semibold text-white">
								Pick up kiddos <span class="font-normal text-white/50">· 3:00pm</span>
							</p>
						</div>

						<div
							class="flex items-center gap-2.5 rounded-2xl border border-white/15 bg-navy-900/85 px-3.5 py-2.5 shadow-lift backdrop-blur"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-petal-violet" aria-hidden="true"></span>
							<p class="text-sm font-semibold text-white">
								Dinner date <span class="font-normal text-white/50">· 6:00pm</span>
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- How it works -->
		<section id="how-it-works" class="scroll-mt-24 bg-white px-5 py-20 sm:px-6 lg:py-28">
			<div class="reveal mx-auto max-w-6xl">
				<div class="max-w-2xl">
					<p class="eyebrow text-brand-500">How it works</p>
					<h2 class="mt-3 text-3xl font-extrabold text-navy-900 sm:text-4xl">
						Three steps, then you're out the door
					</h2>
